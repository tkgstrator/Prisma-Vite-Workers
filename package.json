{
	"name": "prisma-vite-workers",
	"version": "1.0.0",
	"description": "Cloudflare Workers fullstack template: Hono + Prisma (D1) + Vite + React with KV, R2 and Durable Objects",
	"author": "@tkgstrator",
	"private": true,
	"license": "MIT",
	"type": "module",
	"scripts": {
		"predev": "bun run generate && bun run migrate:apply",
		"dev": "vite --host",
		"generate": "prisma generate && wrangler types",
		"migrate:new": "prisma migrate diff --from-local-d1 --to-schema prisma/schema.prisma --script",
		"migrate:apply": "wrangler d1 migrations apply DB --local",
		"migrate:remote": "wrangler d1 migrations apply DB --remote --env=${CLOUDFLARE_ENV:-staging}",
		"build": "bun run generate && tsc -b --noEmit && vite build --mode ${CLOUDFLARE_ENV:-staging}",
		"predeploy": "bun run build",
		"deploy": "wrangler deploy --keep-vars --env=${CLOUDFLARE_ENV:-staging}",
		"typecheck": "tsc -b --noEmit",
		"lint": "biome check --write",
		"test": "bun test"
	},
	"dependencies": {
		"@hono/zod-openapi": "^1.6.0",
		"@prisma/adapter-d1": "^7.9.1",
		"@prisma/client": "^7.9.1",
		"@scalar/hono-api-reference": "^0.11.14",
		"@tanstack/react-query": "^5.101.4",
		"@tanstack/react-router": "^1.170.30",
		"dayjs": "^1.11.23",
		"hono": "^4.13.3",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"tailwindcss": "^4.3.3",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.9",
		"@cloudflare/vite-plugin": "^1.53.0",
		"@commitlint/config-conventional": "^21.2.2",
		"@tailwindcss/vite": "^4.3.3",
		"@tanstack/react-router-devtools": "^1.167.1",
		"@tanstack/router-plugin": "^1.168.33",
		"@types/bun": "^1.3.14",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.4",
		"@vitejs/plugin-react-swc": "^4.3.3",
		"prisma": "^7.9.1",
		"typescript": "^7.0.2",
		"vite": "^8.2.1",
		"wrangler": "^4.124.0"
	}
}
