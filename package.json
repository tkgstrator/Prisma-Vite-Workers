{
  "name": "prisma-vite-workers",
  "version": "1.1.0",
  "description": "Cloudflare Workers fullstack template: Hono + Prisma (D1) + Vite + React with KV, R2 and Durable Objects",
  "author": "@tkgstrator",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "predev": "bun run generate && bun run migrate:apply",
    "dev": "vite --host",
    "generate": "prisma generate && wrangler types",
    "migrate:new": "prisma migrate diff --from-local-d1 --to-schema prisma/schema.prisma --script",
    "migrate:apply": "wrangler d1 migrations apply DB --local",
    "migrate:remote": "wrangler d1 migrations apply DB --remote --env=${CLOUDFLARE_ENV:-staging}",
    "build": "bun run generate && tsc -b --noEmit && vite build --mode ${CLOUDFLARE_ENV:-staging}",
    "predeploy": "bun run build",
    "deploy": "wrangler deploy --keep-vars --env=${CLOUDFLARE_ENV:-staging}",
    "typecheck": "tsc -b --noEmit",
    "lint": "biome check --write",
    "test": "bun test"
  },
  "dependencies": {
    "@hono/zod-openapi": "^1.6.3",
    "@prisma/adapter-d1": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@scalar/hono-api-reference": "^0.12.14",
    "@tanstack/react-query": "^5.104.5",
    "@tanstack/react-router": "^1.170.46",
    "dayjs": "^1.11.23",
    "hono": "^4.13.14",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "@cloudflare/vite-plugin": "^1.65.0",
    "@commitlint/config-conventional": "^21.2.4",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-router-devtools": "^1.167.2",
    "@tanstack/router-plugin": "^1.168.48",
    "@types/bun": "^1.4.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "prisma": "^8.0.0-rc.27",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "wrangler": "^4.152.0"
  }
}
